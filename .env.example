# Local inference remains the default. Cloud audio checking requires an
# explicit --allow-cloud-upload flag and an OPENAI_API_KEY in the environment.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# HF_TOKEN is only for downloading an approved model; never commit the token.
HF_TOKEN=
# Audio pipeline defaults. AUDIO_LANGUAGE should normally stay empty so that
# Russian, Kazakh, and mixed speech are detected rather than forced.
AUDIO_STT_MODEL=mlx-community/whisper-small-mlx-q4
AUDIO_LANGUAGE=
AUDIO_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
AUDIO_DIARIZATION_DEVICE=cpu
# Set actual secrets only in your shell or ignored .env, never in Git.
OPENAI_API_KEY=
# NVIDIA API Catalog inference uses a separate key from Brev GPU billing.
NVIDIA_API_KEY=
# Optional for Brev CLI automation; not used by the audio pipeline.
BREV_API_KEY=
